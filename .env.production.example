# ============================================
# IUM-MORAVE — Production Environment
# ============================================

# Node
NODE_ENV=production

# Services
PORT=4002
AUTH_SERVICE_URL=http://localhost:4001
CORE_API_URL=http://localhost:4002
FINANCE_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004

# JWT — À GÉNÉRER AVEC UN SECRET FORT
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
REFRESH_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
RESET_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
EMAIL_VERIFY_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN

# Transcript signing — OBLIGATOIRE EN PRODUCTION
TRANSCRIPT_SIGNING_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN

# Database — PostgreSQL production
DATABASE_URL=postgresql://ium_admin:CHANGE_ME_DB_PASSWORD@db.example.com:5432/ium_morave

# Supabase (optionnel si DB directe)
SUPABASE_URL=https://yznnnqofezjinjdfmemy.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# SMTP — Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=IUM-MORAVE <no-reply@ium-morave.edu>

# Public verification URL
PUBLIC_VERIFICATION_URL=https://ium-morave.vercel.app/verify

# Security
CORS_ORIGIN=https://ium-morave.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Document security secrets — À GÉNÉRER AVEC openssl rand -hex 32
WATERMARK_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
TIMESTAMP_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
ADVANCED_SIGN_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
DOCUMENT_SECURITY_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_64_CHARS_MIN
